{
  "framework": null,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/c/:client/p/:bp",
      "destination": "/api/page?client=:client&bp=:bp"
    },
    {
      "source": "/",
      "destination": "/api/page?catalog=1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
