{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/c/:client/p/:bp",
      "destination": "/prompt-free"
    },
    {
      "source": "/c/:client/p/:bp/",
      "destination": "/prompt-free"
    },
    {
      "source": "/member",
      "destination": "/member.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/instagram",
      "destination": "/instagram.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "badaiprompt.vercel.app"
        }
      ],
      "destination": "https://promptional.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "badaiprompt.vercel.app"
        }
      ],
      "destination": "https://promptional.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/member-area",
      "destination": "/member",
      "permanent": false
    },
    {
      "source": "/member-area.html",
      "destination": "/member",
      "permanent": false
    },
    {
      "source": "/member.html",
      "destination": "/member",
      "permanent": false
    },
    {
      "source": "/akses",
      "destination": "/member",
      "permanent": false
    },
    {
      "source": "/akses.html",
      "destination": "/member",
      "permanent": false
    }
  ]
}
